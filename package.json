{
  "name": "@bfchain/core",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "version": "4.13.14-test",
  "description": "",
  "main": "build/cjs/index.js",
  "module": "build/esm/index.js",
  "-type": "build/cjs/index.d.ts",
  "bdkMono": {
    "generateConfigFiles": [
      {
        "packages": "*",
        "type": "mergejson",
        "from": "$ROOT_PROJECT/config/tsconfig_template/tsconfig.cjs.json",
        "to": "$PACKAGE/tsconfig.json"
      },
      {
        "packages": "*,-test",
        "type": "mergejson",
        "from": "$ROOT_PROJECT/config/tsconfig_template/tsconfig.cjs-es5.json",
        "to": "$PACKAGE/tsconfig.cjs-es5.json"
      },
      {
        "packages": "*,-test",
        "type": "mergejson",
        "from": "$ROOT_PROJECT/config/tsconfig_template/tsconfig.esm-es6.json",
        "to": "$PACKAGE/tsconfig.esm-es6.json"
      },
      {
        "packages": "*,-test",
        "type": "mergejson",
        "from": "$ROOT_PROJECT/config/tsconfig_template/tsconfig.esm.json",
        "to": "$PACKAGE/tsconfig.esm.json"
      },
      {
        "packages": "*,-test",
        "type": "jsonfromjs",
        "src": "$ROOT_PROJECT/config/tsconfig_template/tsconfig.@types.js",
        "to": "$PACKAGE/tsconfig.@types.json"
      }
    ]
  },
  "scripts": {
    "clear": "node ./scripts/rmBuild.js",
    "up": "yarn upgrade-interactive --latest",
    "mono": "bdk-mono",
    "publ": "lerna publish",
    "publ:force": "lerna publish --force-publish",
    "lsts": "bdk-lsts -p=./tsconfig.json",
    "build": "bdk-tsc --build ./tsconfig.all.json",
    "dev:all": "bdk-tsc --build ./tsconfig.all.json -w",
    "dev:cjs-es5": "bdk-tsc --build ./tsconfig.cjs-es5.json -w",
    "dev:types": "bdk-tsc --build ./tsconfig.@types.json -w",
    "rebuild": "npm run clear & npm run build",
    "dev": "bdk-tsc --build -w"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "lerna": "^3.19.0",
    "@bfchain/devkit": "^0.7.8"
  },
  "dependencies": {}
}
